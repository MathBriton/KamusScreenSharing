{
  "name": "kamus-screen-sharing",
  "private": true,
  "version": "0.1.0",
  "description": "Compartilhamento de tela 1-para-muitos no navegador, usando WebRTC com SFU (LiveKit).",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace server && npm run build --workspace web",
    "typecheck": "npm run typecheck --workspaces",
    "start": "npm run start --workspace server",
    "livekit": "docker compose up livekit",
    "test:e2e": "playwright test",
    "livekit:local": "sh scripts/livekit-dev.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
