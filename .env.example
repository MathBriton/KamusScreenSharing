# Credenciais do LiveKit. Os valores abaixo são os do modo --dev do livekit-server
# (docker compose). Em produção, gere chaves próprias.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Porta da API (servidor de tokens)
PORT=3001

# Chat: banco SQLite e imagens coladas
DATA_DIR=./data
RETENTION_DAYS=90
MAX_UPLOAD_MB=10
